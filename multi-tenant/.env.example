# ================================================
# NEXO IA - Multi-Tenant Configuration
# ================================================

# Dominio base (ej: nexoai.com)
# Las instancias serán: cliente1.nexoai.com, cliente2.nexoai.com
BASE_DOMAIN=nexoai.com

# Email para certificados SSL Let's Encrypt
ACME_EMAIL=admin@nexoai.com

# ================================================
# POSTGRESQL
# ================================================
POSTGRES_ADMIN_USER=nexo_admin
POSTGRES_ADMIN_PASSWORD=SuperSecurePassword123!
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ================================================
# REDIS
# ================================================
REDIS_PASSWORD=RedisSecurePassword123!
REDIS_HOST=redis
REDIS_PORT=6379

# ================================================
# PANEL DE CONTROL
# ================================================
PANEL_SECRET_KEY=GenerateRandomSecretKey32Chars!
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=AdminPassword123!

# ================================================
# CONFIGURACIÓN POR DEFECTO PARA NUEVAS INSTANCIAS
# ================================================
DEFAULT_N8N_VERSION=latest
DEFAULT_EXECUTION_MODE=queue
DEFAULT_TIMEZONE=Europe/Madrid

# Recursos por instancia (límites Docker)
DEFAULT_CPU_LIMIT=1.0
DEFAULT_MEMORY_LIMIT=2g
DEFAULT_MEMORY_RESERVATION=512m

# ================================================
# LÍMITES DEL SISTEMA
# ================================================
MAX_INSTANCES=50
MAX_WORKFLOWS_PER_INSTANCE=100
MAX_EXECUTIONS_PER_DAY=10000
