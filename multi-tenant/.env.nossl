# ================================================
# NEXO IA - Configuración SIN DOMINIO (Solo IP)
# ================================================

# IP PÚBLICA de tu VPS Hostinger
VPS_IP=123.456.789.123

# POSTGRESQL
POSTGRES_ADMIN_USER=nexo_admin
POSTGRES_ADMIN_PASSWORD=MiPasswordSeguro123!

# REDIS
REDIS_PASSWORD=RedisPassword123!

# PANEL DE CONTROL
# Acceso: http://TU_IP:3000
PANEL_SECRET_KEY=mi-clave-secreta-muy-larga-32chars
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=admin123

# PUERTOS PARA INSTANCIAS
# Cada nueva instancia usará un puerto secuencial
BASE_PORT=5678
# Cliente 1: http://TU_IP:5678
# Cliente 2: http://TU_IP:5679
# Cliente 3: http://TU_IP:5680
# etc.

# CONFIGURACIÓN n8n
DEFAULT_N8N_VERSION=latest
DEFAULT_TIMEZONE=Europe/Madrid

# LÍMITES
MAX_INSTANCES=20
