# ================================================
# NEXO IA - Multi-Tenant Configuration
# Hostinger VPS Compatible
# ================================================

# Dominio base (tu dominio de Hostinger)
BASE_DOMAIN=srv869945.hstgr.cloud

# ================================================
# POSTGRESQL
# ================================================
POSTGRES_ADMIN_USER=nexo_admin
POSTGRES_ADMIN_PASSWORD=CambiaEstoPassword123!

# ================================================
# REDIS
# ================================================
REDIS_PASSWORD=CambiaRedisPassword123!

# ================================================
# PANEL DE CONTROL
# ================================================
PANEL_SECRET_KEY=GeneraUnSecretoAqui32Caracteres
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=CambiaPasswordPanel123!

# ================================================
# CONFIGURACIÓN POR DEFECTO
# ================================================
DEFAULT_CPU_LIMIT=1.0
DEFAULT_MEMORY_LIMIT=2g

# Límites del sistema
MAX_INSTANCES=50
